# Browser-safe Supabase project URL (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe Supabase publishable key (Settings > API).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: required by GM account creation and scripts/bootstrap-gm.mjs.
# Never prefix this value with NEXT_PUBLIC_, and never commit its real value.
SUPABASE_SERVICE_ROLE_KEY=

# One-time local Bootstrap script inputs. Set them only in your shell when needed;
# do not keep administrator passwords in this file.
# BOOTSTRAP_GM_EMAIL=
# BOOTSTRAP_GM_PASSWORD=
# BOOTSTRAP_GM_DISPLAY_NAME=
